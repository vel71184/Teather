# Copy to `keystore.properties` (gitignored) to produce a distributable,
# release-signed APK. See docs/DECISIONS.md D-030.
#
# 1. Create the keystore ONCE, outside the repo, and back it up. A lost release
#    key cannot be recovered and cannot be rotated for already-installed users:
#
#      keytool -genkeypair -v \
#        -keystore "$HOME/.teather/teather-release.jks" \
#        -alias teather -keyalg RSA -keysize 4096 -validity 10000
#
# 2. Fill in the four values below. `storeFile` may be absolute or relative to
#    the repo root. When this file is absent the build falls back to the debug
#    key (with a warning) and that APK is NOT for distribution.
#
# Alternatively set TEATHER_KEYSTORE / TEATHER_KEYSTORE_PASSWORD /
# TEATHER_KEY_ALIAS / TEATHER_KEY_PASSWORD in the environment.

storeFile=/home/CHANGE_ME/.teather/teather-release.jks
storePassword=CHANGE_ME
keyAlias=teather
keyPassword=CHANGE_ME
