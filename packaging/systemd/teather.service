[Unit]
Description=Teather per-user USB relay manager
Documentation=file:///usr/share/doc/teather/RECOVERY.md.gz

[Service]
Type=dbus
BusName=io.github.vel71184.Teather1
ExecStart=/usr/bin/teatherd
Restart=on-failure
RestartSec=2
# D-022: the manager no longer invokes a setuid-root helper. NetworkManager owns
# the teather0 connection and tun2proxy attaches to the tun.owner-delegated
# device as the desktop user, so the daemon needs no elevation of its own.
# (Keep the directive set to what a `systemd --user` manager can actually apply
# without capabilities — heavier Protect*/Restrict* options fail at step
# CAPABILITIES in a user unit.)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
RestrictSUIDSGID=yes
LockPersonality=yes
# StateDirectory gives the daemon a private (0700) ~/.local/state/teather for
# its rotating debug log (teatherd.log); systemd creates it and adds it to the
# unit's writable paths. ProtectHome=read-only still applies everywhere else.
StateDirectory=teather
ReadWritePaths=-%h/.config/teather -%t/teather -%S/teather

[Install]
WantedBy=default.target
