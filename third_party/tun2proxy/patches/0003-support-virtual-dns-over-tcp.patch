+async fn handle_virtual_dns_tcp_stream<S>(mut tcp: S, dns: Arc<Mutex<VirtualDns>>) -> crate::Result<()>
+where
+    S: AsyncRead + AsyncWrite + Unpin,
+{
+    loop {
+        let length = match tcp.read_u16().await {
+            Ok(length) => usize::from(length),
+            Err(error) if error.kind() == ErrorKind::UnexpectedEof => break,
+            Err(error) => return Err(error.into()),
+        };
+        if length == 0 || length > MAX_VIRTUAL_DNS_MESSAGE {
+            return Err("Invalid virtual DNS TCP message length".into());
+        }
+        let mut query = vec![0_u8; length];
+        tcp.read_exact(&mut query).await?;
+        let (message, qname, ip) = dns.lock().await.generate_query(&query)?;
+        let response_length = u16::try_from(message.len()).map_err(|_| "Virtual DNS TCP response is too large")?;
+        tcp.write_u16(response_length).await?;
+        tcp.write_all(&message).await?;
+        tcp.flush().await?;
+        log::debug!("Virtual DNS TCP query: {qname} -> {ip}");
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod teather_virtual_dns_tcp_tests {
+    use super::*;
+    use std::str::FromStr;
+    use tokio::io::duplex;
+    use tproxy_config::IpCidr;
+
+    fn query() -> Vec<u8> {
+        vec![
+            0x54, 0x45, 0x01, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+            0x07, b't', b'e', b'a', b't', b'h', b'e', b'r',
+            0x07, b'i', b'n', b'v', b'a', b'l', b'i', b'd',
+            0x00, 0x00, 0x01, 0x00, 0x01,
+        ]
+    }
+
+    #[tokio::test]
+    async fn virtual_dns_tcp_uses_length_prefixed_messages() {
+        let (mut client, server) = duplex(8192);
+        let dns = Arc::new(Mutex::new(VirtualDns::new(
+            IpCidr::from_str("198.18.0.0/16").unwrap(),
+        )));
+        let task = tokio::spawn(handle_virtual_dns_tcp_stream(server, dns));
+        let query = query();
+        client.write_u16(query.len() as u16).await.unwrap();
+        client.write_all(&query).await.unwrap();
+        let response_length = client.read_u16().await.unwrap() as usize;
+        assert!(response_length >= query.len());
+        let mut response = vec![0_u8; response_length];
+        client.read_exact(&mut response).await.unwrap();
+        assert_eq!(&response[..2], &[0x54, 0x45]);
+        assert_ne!(response[2] & 0x80, 0);
+        drop(client);
+        task.await.unwrap().unwrap();
+    }
+
+    #[tokio::test]
+    async fn virtual_dns_tcp_rejects_zero_length_messages() {
+        let (mut client, server) = duplex(64);
+        let dns = Arc::new(Mutex::new(VirtualDns::new(
+            IpCidr::from_str("198.18.0.0/16").unwrap(),
+        )));
+        let task = tokio::spawn(handle_virtual_dns_tcp_stream(server, dns));
+        client.write_u16(0).await.unwrap();
+        assert!(task.await.unwrap().is_err());
+    }
+}
